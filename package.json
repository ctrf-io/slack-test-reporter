{
	"name": "slack-ctrf",
	"version": "0.1.0",
	"description": "Send Slack notifications with test results from popular testing frameworks",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"build:check": "tsc -p . --noEmit",
		"build:watch": "tsup --watch",
		"clean": "rm -rf dist && rm -rf coverage && rm -rf ctrf",
		"test": "npm run build && vitest run",
		"test:coverage": "npm run build && vitest run --coverage",
		"lint": "biome lint --write . --unsafe",
		"lint:check": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"docs": "typedoc",
		"docs:watch": "typedoc --watch",
		"prepublishOnly": "npm run clean && npm run build",
		"e2e": "node scripts/e2e-test.js",
		"all": "npm run build:check && npm run test:compile && npm run lint:check && npm run format:check && npm run test:coverage && npm run build",
		"test:watch": "vitest",
		"test:compile": "npm run build && tsc -p tsconfig.test.json --noEmit",
		"check": "biome check ."
	},
	"bin": {
		"slack-ctrf": "./dist/cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ctrf-io/slack-test-reporter.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"homepage": "https://ctrf.io",
	"files": [
		"dist/",
		"README.md"
	],
	"author": "Matthew Thomas",
	"license": "MIT",
	"engines": {
		"node": ">=20.19.0"
	},
	"dependencies": {
		"@slack/web-api": "8.2.0",
		"@slack/webhook": "8.0.2",
		"ctrf": "0.4.0",
		"glob": "13.0.6",
		"handlebars": "4.7.9",
		"handlebars-helpers-ctrf": "0.0.8",
		"yargs": "18.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@d2t/vitest-ctrf-json-reporter": "1.3.0",
		"@types/node": "26.6.4",
		"@types/yargs": "17.0.35",
		"@vitest/coverage-v8": "5.0.3",
		"tsup": "8.5.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "5.0.3"
	},
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	}
}
